# Makefile
SIM ?= icarus
TOPLEVEL_LANG ?= verilog

# Include all source files
VERILOG_SOURCES += $(PWD)/sources/process_packets.sv
# Note: desigprocess_packetsn.sv includes async_fifo.sv and pattern_detector.sv [cite: 15]

# TOPLEVEL is the name of the module in your Verilog file [cite: 15]
TOPLEVEL = system_top

# MODULE is the name of the Python test file (without .py)
MODULE = test_system

# Enable waveform dumping for Icarus
ifeq ($(SIM), icarus)
    PLUSARGS += -fst
endif

include $(shell cocotb-config --makefiles)/Makefile.sim